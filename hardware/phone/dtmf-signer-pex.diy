<?xml version="1.0" encoding="UTF-8" ?>
<project>
  <fileVersion>
    <major>6</major>
    <minor>8</minor>
    <build>0</build>
  </fileVersion>
  <title>DTMF-Signer, Phone Exchange (PEX), breadboard</title>
  <author>NDS-Signer</author>
  <description>Phone Exchange (PEX) of DTMF-Signer on a full-size breadboard: Raspberry Pi Pico, a 5 to 12 V MT3608 boost module and an LM317 current source feeding a tone telephone's line (RJ11 socket), line in to GP27, audio out from GP15, hook sense on GP28. Rails: top outer 3V3, top inner GND, bottom inner LINE A (up to 12 V), bottom outer GND. Never connect it to the real telephone network. Hardware licence: CERN-OHL-S v2. https://github.com/ndssigner/dtmf-signer</description>
  <width value="29.0" unit="cm"/>
  <height value="21.0" unit="cm"/>
  <gridSpacing value="0.1" unit="in"/>
  <dotSpacing>1</dotSpacing>
